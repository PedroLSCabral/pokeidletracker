# Serviço systemd para rodar o robô coletor 24h numa VM Linux.
# Ajuste User e os caminhos, depois:
#   sudo cp deploy/pokeidle-robo.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now pokeidle-robo
#   journalctl -u pokeidle-robo -f        # acompanhar o log
[Unit]
Description=PokeIdle Tracker - robo coletor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/pokeidletracker
ExecStart=/home/ubuntu/pokeidletracker/.venv/bin/python src/robo.py
Restart=on-failure
RestartSec=300
# Saída 1 = recusa de conta (token inválido, ban...): não adianta reiniciar em laço.
RestartPreventExitStatus=3

[Install]
WantedBy=multi-user.target
