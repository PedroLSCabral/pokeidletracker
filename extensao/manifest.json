{
  "manifest_version": 3,
  "name": "PokeIdle Tracker – Coletor",
  "version": "1.0.0",
  "description": "Liga a aba do jogo ao robô do PokeIdle Tracker no próprio PC (127.0.0.1), pelo socket que o jogo já tem aberto.",
  "background": { "service_worker": "fundo.js" },
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["https://pokeidle.io/*"],
      "js": ["pagina.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://pokeidle.io/*"],
      "js": ["aba.js"],
      "run_at": "document_start"
    }
  ]
}
